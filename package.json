{
  "name": "tunebox",
  "version": "1.0.1",
  "productName": "TuneBox",
  "description": "Search, stream and download music from YouTube Music",
  "main": "./out/main/index.js",
  "author": "Yehuda",
  "type": "module",
  "desktopName": "tunebox.desktop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -w",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "node scripts/fetch-binaries.mjs win && electron-vite build && electron-builder --win",
    "build:linux": "node scripts/fetch-binaries.mjs linux && electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "preview:web": "vite --config vite.preview.config.ts",
    "build:win:zip": "node scripts/fetch-binaries.mjs win && electron-vite build && electron-builder --win zip -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^6.0.0",
    "electron-log": "^5.4.4",
    "music-metadata": "^12.5.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.73.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
